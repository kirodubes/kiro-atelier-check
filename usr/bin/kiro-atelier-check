        ("GeForce RTX 30", N_("Desktop"), "RTX 3050 6GB, 3050 8GB, 3060, 3060 Ti, 3070, 3070 Ti, 3080, 3080 Ti, "
                                          "3090, 3090 Ti"),
        ("GeForce RTX 30", N_("Laptop"), "RTX 3050 6GB, 3060, 3070, 3070 Ti, 3080, 3080 Ti"),
        ("GeForce RTX 40", N_("Desktop"), "RTX 4060, 4060 Ti, 4070, 4070 Super, 4070 Ti, 4070 Ti Super, 4080, "
                                          "4080 Super, 4090"),
