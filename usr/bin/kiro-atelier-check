    ]),
    (FAIL, N_("Doesn't work"), [
        (N_("Less than 6 GB"), N_("of video memory"),
         N_("GTX 1630, 1650 (all versions) · RTX 2050 · RTX 3050 4GB, 3050 Ti and 3050 A (laptop) · MX series · "
         "T400, T500, T550, T600, T1000 4GB, T1200, T2000 · RTX A400, A500, A1000 4GB (laptop), A2000 4GB (laptop) · "
         "RTX 500 Ada")),
        (N_("Too old"), N_("before the RTX 20 / GTX 16 generation"),
         N_("GTX 10xx and older (1080 Ti, 1070, 1060 …) · Titan X, Titan Xp, Titan V · Quadro P and M series, "
            "Quadro GV100")),
        (N_("Not NVIDIA"), "", N_("AMD Radeon, Intel Arc, graphics built into the processor")),
    ]),
]
CARD_NOTE = N_("Tested on an RTX 2060 (6 GB); the other cards meet the same requirements but haven't been tried. "
               "Laptop and workstation cards with the same name can have different amounts of video memory, and a "
               "laptop card paints slower than the desktop card with the same name. KA Check on the PC itself has the "
               "last word.")


def show_cards(parent, app=None):
    """A window with the card list: works, works slowly, doesn't work."""
    from gi.repository import Gtk

    window = Gtk.Window(transient_for=parent, application=app, title=_("Which graphics cards work?"),
                        default_width=820, default_height=640)
    window.set_icon_name("kiro-atelier-check")
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=20, margin_bottom=8,
                  margin_start=20, margin_end=20)
    for status, heading, groups in CARD_LIST:
        title = Gtk.Box(spacing=10, margin_top=6)
        mark = Gtk.Label(label={OK: "✔", WARN: "!", FAIL: "✘"}[status])
        mark.add_css_class(status)
        mark.add_css_class("section")
        title.append(mark)
        name = Gtk.Label(label=_(heading), xalign=0, wrap=True)
        name.add_css_class("section")
        title.append(name)
        box.append(title)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.add_css_class("tip")
        grid = Gtk.Grid(column_spacing=16, row_spacing=10, margin_top=14, margin_bottom=14, margin_start=18,
                        margin_end=18)
        for row, (title, kind, cards) in enumerate(groups):
            # Product names (GeForce RTX 30) pass through _() unchanged; only the N_() words are in the catalogs.
            head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.START)
            label = Gtk.Label(label=_(title), xalign=0, wrap=True, width_chars=16, max_width_chars=18)
            label.add_css_class("tip-title")
            head.append(label)
            if kind:
                sub = Gtk.Label(label=_(kind), xalign=0, wrap=True, max_width_chars=18)
                sub.add_css_class("dim-label")
                head.append(sub)
            grid.attach(head, 0, row, 1, 1)
            grid.attach(Gtk.Label(label=_(cards), xalign=0, yalign=0, wrap=True, hexpand=True, max_width_chars=70),
                        1, row, 1, 1)
        card.append(grid)
        box.append(card)
    note = Gtk.Label(label=_(CARD_NOTE), xalign=0, wrap=True, margin_top=6)
    note.add_css_class("dim-label")
    box.append(note)
    scroller = Gtk.ScrolledWindow(child=box, hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
    close = Gtk.Button(label=_("Close"), halign=Gtk.Align.END, margin_end=20, margin_bottom=16, margin_top=8)
    close.connect("clicked", lambda _widget: window.close())
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    outer.append(scroller)
    outer.append(close)
    window.set_child(outer)
    window.present()


# ── Style gallery ───────────────────────────────────────────────────
# What Kiro Atelier paints: every ready-made profile on the same 4 photos (exported from KA's tools/style_gallery.py).
# Next to the script: /usr/bin → /usr/share when installed, usr/bin → usr/share in the source tree.
