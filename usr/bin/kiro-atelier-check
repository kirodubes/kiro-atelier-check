        ("GeForce RTX 50", N_("Laptop"), "RTX 5050, 5060, 5070, 5070 Ti, 5080, 5090"),
        (N_("Workstation"), N_("Desktop"), "Quadro RTX 4000, 5000, 6000, 8000 · RTX A1000, A2000, A4000, A4500, "
                                           "A5000, A5500, A6000 · RTX 2000 Ada, 4000 SFF Ada, 4000 Ada, 4500 Ada, "
                                           "5000 Ada, 6000 Ada · RTX PRO 2000, 4000, 4000 SFF, 4500, 5000, 6000 "
                                           "Blackwell"),
        (N_("Workstation"), N_("Laptop"), "Quadro RTX 3000, 4000, 5000, 6000 · RTX A1000 6GB, A2000 8GB, A3000, "
                                          "A4000, A4500, A5000, A5500 · RTX 1000 Ada, 2000 Ada, 3000 Ada, 3500 Ada, "
                                          "4000 Ada, 5000 Ada · RTX PRO 500, 1000, 2000, 3000, 4000, 5000 Blackwell"),
    ]),
