# The buy card shows one photo in four styles; its caption names them in this order.
# The mountain lake shows the styles best (2026-11-07); the caption names these styles, change both together.
HERO_PICTURES = ["original-mountain-lake.jpg", "palette-knife-mountain-lake.jpg", "poster-studio-mountain-lake.jpg",
                 "edo-landscape-mountain-lake.jpg"]
KOFI_URL = "https://ko-fi.com/s/6ff5175237"


def load_gallery():
    """The gallery data, or None when it isn't installed."""
    try:
        return json.loads((GALLERY_DIR / "gallery.json").read_text())
    except (OSError, ValueError):
        return None


def show_gallery(parent, data):
    """A scrolling page with one card per profile; a click shows a painting big, arrow keys move on."""
    from gi.repository import Gdk, Gtk

    items = []  # (file, caption) in page order

    def viewer(index):
        window = Gtk.Window(transient_for=gallery, modal=True, title=_("What Kiro Atelier paints"), default_width=1200,
                            default_height=760)
        picture = Gtk.Picture(can_shrink=True, content_fit=Gtk.ContentFit.CONTAIN, vexpand=True)
        caption = Gtk.Label(margin_top=8, margin_bottom=10, wrap=True)
        at = [index]

        def show():
            file, text = items[at[0]]
            picture.set_filename(str(GALLERY_DIR / "view" / file))
            caption.set_label(_("{caption} ({current} / {total})").format(
                caption=text, current=at[0] + 1, total=len(items)))

        def on_key(_controller, keyval, _code, _state):
            if keyval == Gdk.KEY_Escape:
                window.close()
            elif keyval in (Gdk.KEY_Right, Gdk.KEY_Down, Gdk.KEY_space, Gdk.KEY_Left, Gdk.KEY_Up):
                at[0] = (at[0] + (-1 if keyval in (Gdk.KEY_Left, Gdk.KEY_Up) else 1)) % len(items)
                show()
            else:
                return False
            return True
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", on_key)
        window.add_controller(keys)
        click = Gtk.GestureClick()
        click.connect("released", lambda *_args: window.close())
        picture.add_controller(click)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(picture)
        box.append(caption)
        window.set_child(box)
        show()
        window.present()

    def card(title, meta, text, files, captions):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.add_css_class("tip")
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=16, margin_bottom=16,
                        margin_start=20, margin_end=20)
        name = Gtk.Label(label=title, xalign=0)
        name.add_css_class("tip-title")
        inner.append(name)
        if meta:
            line = Gtk.Label(label=meta, xalign=0, wrap=True)
            line.add_css_class("dim-label")
            inner.append(line)
        inner.append(Gtk.Label(label=text, xalign=0, wrap=True))
        grid = Gtk.Grid(column_spacing=8, column_homogeneous=True, margin_top=4)
        for column, (file, text_) in enumerate(zip(files, captions)):
            index = len(items)
            items.append((file, text_))
            picture = Gtk.Picture(can_shrink=True, content_fit=Gtk.ContentFit.COVER, tooltip_text=text_,
                                  hexpand=True, overflow=Gtk.Overflow.HIDDEN)
            picture.set_filename(str(GALLERY_DIR / "thumb" / file))
            # A fixed height: the width follows the window and COVER crops a little when it is wide.
            picture.set_size_request(120, 130)
            picture.add_css_class("thumb")
            picture.set_cursor_from_name("zoom-in")
            press = Gtk.GestureClick()
            press.connect("released", lambda *_args, index=index: viewer(index))
            picture.add_controller(press)
            grid.attach(picture, column, 0, 1, 1)
        inner.append(grid)
        outer.append(inner)
        return outer

    gallery = Gtk.Window(transient_for=parent, title=_("What Kiro Atelier paints"), default_width=1100,
                         default_height=820)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=20, margin_bottom=8,
                  margin_start=20, margin_end=20)
    intro = Gtk.Label(label=_("Every ready-made style of Kiro Atelier on the same 4 photos. Click a picture to see it "
                              "big; the arrow keys move on."), xalign=0, wrap=True)
    intro.add_css_class("dim-label")
    box.append(intro)
    titles = [_(title) for title in GALLERY_PICTURES]
    box.append(card(_("Originals"), "", _("The 4 photos every style below starts from."),
                    [p["file"] for p in data["pictures"]], titles))
    for index, profile in enumerate(data["profiles"]):
        box.append(card(profile["name"], _(GALLERY_META[index]), _(GALLERY_DESCRIPTIONS[index]), profile["files"],
                        [f"{profile['name']} · {title}" for title in titles]))
    scroller = Gtk.ScrolledWindow(child=box, hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
    close = Gtk.Button(label=_("Close"), halign=Gtk.Align.END, margin_end=20, margin_bottom=16, margin_top=8)
    close.connect("clicked", lambda _widget: gallery.close())
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    outer.append(scroller)
    outer.append(close)
    gallery.set_child(outer)
    gallery.present()


# ── Window ──────────────────────────────────────────────────────────
CSS = (b".ok { color: #2ec27e; } .warn { color: #e5a50a; } .fail { color: #e01b24; }"
       b".verdict { font-size: 1.3em; font-weight: bold; }"
       b".section { font-size: 1.15em; font-weight: bold; }"
       b".tip { background-color: alpha(currentColor, 0.06); border-radius: 12px; }"
       b".tip-title { font-weight: bold; } .thumb { border-radius: 6px; }"
       b".buy { background-image: linear-gradient(135deg, alpha(#3584e4, 0.20), alpha(#e5a50a, 0.16));"
       b" border: 1px solid alpha(#3584e4, 0.45); border-radius: 14px; }"
       b".buy-title { font-size: 1.45em; font-weight: bold; }"
       b".buy-button { font-size: 1.2em; font-weight: bold; padding: 10px 30px; border-radius: 999px;"
       b" color: white; background-image: linear-gradient(135deg, #f66151, #e5a50a); }"
       b".buy-button:hover { background-image: linear-gradient(135deg, #ff7b6b, #f5b82a); }")


def _add_css(Gtk):
    css = Gtk.CssProvider()
    css.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_display(
        Gtk.Widget.get_display(Gtk.Label()), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def buy_card(Gtk, window, data, can_run):
    """The Ko-fi offer: one photo in four styles, a short pitch and a big buy button."""
    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=8)
    card.add_css_class("buy")
    inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=20, margin_bottom=20,
                    margin_start=24, margin_end=24)
    title = Gtk.Label(label=_("Your PC is ready: turn your photos into paintings") if can_run
                      else _("Kiro Atelier: your photos as paintings"), xalign=0, wrap=True)
    title.add_css_class("buy-title")
    inner.append(title)
    inner.append(Gtk.Label(label=_("Kiro Atelier repaints your photos as 4K wallpapers: thick impasto, watercolour, "
                                   "gouache, pastel, Japanese woodblock print, charcoal and more. It paints on your "
                                   "own PC, so your photos never leave your home."),
                           xalign=0, wrap=True, max_width_chars=85))
    if not can_run:
        inner.append(Gtk.Label(label=_("Get it once a PC in your home passes this check."), xalign=0, wrap=True))
    class Photo(Gtk.Picture):
        # Height follows width, so the photo keeps its shape on any window width. A plain shrinkable
        # GtkPicture has a minimum height of 0, and a short window squeezed the strip flat.
        def do_measure(self, orientation, for_size):
            if orientation == Gtk.Orientation.HORIZONTAL:
                return 150, 400, -1, -1
            if for_size <= 0:
                return (Gtk.Picture.do_measure(self, orientation, 150)[1],
                        Gtk.Picture.do_measure(self, orientation, 400)[1], -1, -1)
            natural = Gtk.Picture.do_measure(self, orientation, for_size)[1]
            return natural, natural, -1, -1

    strip = Gtk.Box(spacing=8, homogeneous=True)
    for file in HERO_PICTURES:
        # The big view files: on a wide window the pictures grow past the 400 px thumbnails.
        path = GALLERY_DIR / "view" / file
        if path.is_file():
            picture = Photo(can_shrink=True, content_fit=Gtk.ContentFit.CONTAIN, hexpand=True)
            picture.set_filename(str(path))
            picture.add_css_class("thumb")
            strip.append(picture)
    if strip.get_first_child():
        inner.append(strip)
        caption = Gtk.Label(label=_("One photo, four looks: the original, Palette Knife, Poster Studio and Edo Landscape."),
                            xalign=0, wrap=True)
        caption.add_css_class("dim-label")
        inner.append(caption)
    buttons = Gtk.Box(spacing=12)
    buy = Gtk.Button(label=_("Get Kiro Atelier on Ko-fi"))
    buy.add_css_class("suggested-action")
    buy.add_css_class("buy-button")
    buy.set_tooltip_text(KOFI_URL)
    buy.connect("clicked", lambda _widget: Gtk.UriLauncher.new(KOFI_URL).launch(window, None, None))
    buttons.append(buy)
    if data:
        see = Gtk.Button(label=_("See what Kiro Atelier paints"), valign=Gtk.Align.CENTER)
        see.connect("clicked", lambda _widget: show_gallery(window, data))
        buttons.append(see)
    inner.append(buttons)
    link = Gtk.LinkButton(uri=KOFI_URL, label=KOFI_URL.removeprefix("https://"), halign=Gtk.Align.START)
    inner.append(link)
    card.append(inner)
    return card


def show_cards_window():
    """Only the card list, as its own window (Kiro Atelier's menu opens it this way)."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gtk

    def activate(app):
        _add_css(Gtk)
        show_cards(None, app)

    # Its own id, so it opens next to a running KA Check window instead of raising that one.
    app = Gtk.Application(application_id="be.kiroproject.ka-check.cards")
    app.connect("activate", activate)
    app.run([sys.argv[0]])
    return 0


def show_window(results):
    """Show the report in a small GTK 4 window."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gtk


    def activate(app):
        _add_css(Gtk)
        window = Gtk.ApplicationWindow(application=app, title="KA Check", default_width=780)
        window.set_icon_name("kiro-atelier-check")
        header = Gtk.HeaderBar(title_widget=Gtk.Label(label="KA Check"))
        language_codes = [None, *available()]
        language_labels = [_("System ({language})").format(language=language_name(SYSTEM))]
        language_labels.extend(language_name(code) for code in language_codes[1:])
        language = Gtk.DropDown.new_from_strings(language_labels)
        language.set_tooltip_text(_("Language"))
        language.set_selected(language_codes.index(chosen()))
        restart = Gtk.Button(label=_("Restart now"), visible=False)
        restart.add_css_class("suggested-action")
        header.pack_end(language)
        header.pack_end(restart)
        window.set_titlebar(header)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=20, margin_bottom=20,
                      margin_start=20, margin_end=20)
        language_message = Gtk.Label(xalign=0, wrap=True, visible=False)
        box.append(language_message)

        def on_language(dropdown):
            code = language_codes[dropdown.get_selected()]
            save_choice(code)
            changed = (code or SYSTEM) != (ACTIVE or SYSTEM)
            language_message.set_text(
                _("Saved. The new language appears when KA Check starts again.") if changed else "")
            language_message.set_visible(changed)
            restart.set_visible(changed)

        def on_restart(_widget):
            restore_environment()
            os.execv(sys.executable, [sys.executable, os.path.abspath(sys.argv[0]), *sys.argv[1:]])

        language.connect("notify::selected", lambda dropdown, _pspec: on_language(dropdown))
        restart.connect("clicked", on_restart)
        status, line = verdict(results)
        head = Gtk.Label(label=line, xalign=0, wrap=True)
        head.add_css_class("verdict")
        head.add_css_class(status)
        box.append(head)
        box.append(Gtk.Label(label=_("Kiro Atelier needs an NVIDIA graphics card with at least 6 GB of video memory "
                                    "(RTX 20 series or newer), 16 GB of memory and about 20 GB of free disk space. "
                                    "Nothing was changed on this PC."),
                             xalign=0, wrap=True, max_width_chars=90))
        cards = Gtk.Button(label=_("Which graphics cards work?"), halign=Gtk.Align.START)
        cards.connect("clicked", lambda _widget: show_cards(window))
        box.append(cards)
        data = load_gallery()
        # Can run: the offer comes right under the verdict. Can't: after the tips, once the reader knows what to fix.
        if status != FAIL:
            box.append(buy_card(Gtk, window, data, can_run=True))
        grid = Gtk.Grid(column_spacing=14, row_spacing=8)
        for row, (title, item_status, detail, more) in enumerate(results):
            mark = Gtk.Label(label={OK: "✔", WARN: "!", FAIL: "✘"}[item_status], valign=Gtk.Align.START)
            mark.add_css_class(item_status)
            check_name = Gtk.Label(label=_(title), xalign=0, valign=Gtk.Align.START)
            check_name.add_css_class("heading")
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
            text.append(Gtk.Label(label=detail, xalign=0, wrap=True, max_width_chars=80))
            if more:
                why = Gtk.Label(label=more, xalign=0, wrap=True, max_width_chars=90, margin_start=16)
                why.add_css_class("dim-label")
                text.append(Gtk.Expander(label=_("More info"), child=why))
            grid.attach(mark, 0, row, 1, 1)
            grid.attach(check_name, 1, row, 1, 1)
            grid.attach(text, 2, row, 1, 1)
        box.append(grid)
        tips = advice(results)
        if tips:
            what = Gtk.Label(label=_("What you can do"), xalign=0, margin_top=16)
            what.add_css_class("section")
            box.append(what)
        for title, text, steps in tips:
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            card.add_css_class("tip")
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=18, margin_bottom=18,
                            margin_start=22, margin_end=22)
            heading = Gtk.Label(label=title, xalign=0, wrap=True)
            heading.add_css_class("tip-title")
            inner.append(heading)
            inner.append(Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=85))
            for number, step in enumerate(steps, 1):
                row = Gtk.Box(spacing=10, margin_start=4)
                badge = Gtk.Label(label=f"{number}.", valign=Gtk.Align.START, width_chars=2, xalign=1)
                badge.add_css_class("tip-title")
                row.append(badge)
                row.append(Gtk.Label(label=step, xalign=0, wrap=True, hexpand=True, max_width_chars=80))
                inner.append(row)
            card.append(inner)
            box.append(card)
        if status == FAIL:
            box.append(buy_card(Gtk, window, data, can_run=False))
        # In a scroller that never scrolls sideways: the labels then wrap at the window's width (a tiling
        # desktop makes the window wide and GTK otherwise sized it to the longest line, cutting it off).
        box.set_margin_bottom(0)
        scroller = Gtk.ScrolledWindow(child=box, hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True,
                                      propagate_natural_height=True)
        close = Gtk.Button(label=_("Close"), halign=Gtk.Align.END, margin_end=20, margin_bottom=16, margin_top=8)
        close.connect("clicked", lambda _widget: window.close())
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(scroller)
        outer.append(close)
        window.set_child(outer)
        window.present()

    app = Gtk.Application(application_id="be.kiroproject.ka-check")
    app.connect("activate", activate)
    app.run([sys.argv[0]])
    return {OK: 0, FAIL: 1, WARN: 2}[verdict(results)[0]]


def main():
    """Run the checks and show them in a window, or in the terminal with --text or without a desktop."""
    desktop = "--text" not in sys.argv and (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
    if "--cards" in sys.argv:
        if desktop:
            try:
                return show_cards_window()
            except (ImportError, ValueError):
                pass
        return show_cards_text()
    results = run_checks()
    if desktop:
        try:
            return show_window(results)
        except (ImportError, ValueError):
            pass
    return show_text(results)


if __name__ == "__main__":
    sys.exit(main())
