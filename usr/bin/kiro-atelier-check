#!/usr/bin/env python3
"""KA Check: tells whether this PC can run Kiro Atelier, before anyone buys it (free, read-only, standalone)."""

# Nothing is installed or changed. Opens a small window when GTK 4 is available, else prints to the terminal;
# --text forces the terminal (--more adds the technical reasons); --cards shows which graphics cards work (a window
# on a desktop, else printed; --cards --text prints).
# Exit code: 0 = can run, 1 = can't, 2 = can run with a warning.

import json
import os
import shutil
import subprocess
import sys
import unicodedata
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "share" / "kiro-atelier-check"))
from kac_i18n import N_, _, restore_environment, chosen, available, name as language_name, SYSTEM, ACTIVE, save_choice  # noqa: E402

OK, WARN, FAIL = "ok", "warn", "fail"
SYSTEM_TITLE = N_("Linux system")
CARD_TITLE = N_("Graphics card")
DRIVER_TITLE = N_("NVIDIA driver")
GENERATION_TITLE = N_("Card generation")
VRAM_TITLE = N_("Video memory")
RAM_TITLE = N_("Memory (RAM)")
DISK_TITLE = N_("Free disk space")
MIN_VRAM_GB = 6
# ComfyUI with SDXL and the naming model holds about 10 GB of RAM.
MIN_RAM_GB, GOOD_RAM_GB = 12, 15
# ComfyUI + PyTorch (~6 GB) + models (~7.5 GB) + room to work.
MIN_DISK_GB = 20
# Turing (RTX 20xx, GTX 16xx) and newer: the PyTorch build Kiro Atelier uses has no code for older cards.
MIN_COMPUTE = 7.5


def _out(argv):
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def _smi(field):
    text = _out(["nvidia-smi", f"--query-gpu={field}", "--format=csv,noheader,nounits"])
    return text.splitlines()[0].strip() if text else None


def _graphics_cards():
    lspci = _out(["lspci"]) or ""
    return [line.split(": ", 1)[-1] for line in lspci.splitlines()
            if "vga" in line.lower() or "3d controller" in line.lower() or "display controller" in line.lower()]


def _nvidia_in_lspci():
    return [card for card in _graphics_cards() if "nvidia" in card.lower()]


def _old_chip():
    # lspci names the chip: GF = Fermi, GK = Kepler, GM = Maxwell, GP = Pascal, GV = Volta, all too old.
    # Turing (TU) and newer pass; the name works without a driver.
    cards = " ".join(_nvidia_in_lspci())
    return any(f"{code}1" in cards or f"[{code}" in cards or f" {code}" in cards
               for code in ("GF", "GK", "GM", "GP", "GV"))


def _no_card_reason():
    if not _nvidia_in_lspci():
        return _("No NVIDIA card.")
    return _("This card is too old (before RTX 20xx / GTX 16xx).") if _old_chip() else _(
        "Unknown until the driver works."
    )


# ── Checks → (title, status, detail[, more]) ─────────────────────────
# more: the technical reason, shown behind "More info".
def check_system():
    if shutil.which("pacman"):
        return SYSTEM_TITLE, OK, _("Arch-based (pacman), so the Kiro Atelier package installs here.")
    return SYSTEM_TITLE, FAIL, _("Kiro Atelier is a package for Arch-based Linux (Kiro, KiroTux, Arch); "
                                 "this system has no pacman.")


def check_card():
    cards = _nvidia_in_lspci()
    if cards:
        return CARD_TITLE, OK, (_smi("name") or cards[0])
    found = _("Found: {cards}. ").format(cards="; ".join(_graphics_cards())) if _graphics_cards() else ""
    return (CARD_TITLE, FAIL, found + _("No NVIDIA card; painting needs one (AMD and Intel are not supported)."),
            _("Kiro Atelier paints with Stable Diffusion XL in ComfyUI, on PyTorch with NVIDIA's CUDA. Intel "
              "graphics have no CUDA and share the normal memory, far too slow and too small for SDXL. AMD cards "
              "would need PyTorch for ROCm, which Kiro Atelier isn't built or tested for. No driver or setting "
              "changes this: it takes an NVIDIA card (RTX 20xx / GTX 16xx or newer, 6 GB) in this PC, or another "
              "Linux PC that has one."))


def check_driver():
    version = _smi("driver_version")
    if version:
        return DRIVER_TITLE, OK, _("Driver {version} is working.").format(version=version)
    if not _nvidia_in_lspci():
        return DRIVER_TITLE, FAIL, _("No NVIDIA card.")
    if _old_chip():
        return (DRIVER_TITLE, FAIL, _("Not working, and current NVIDIA drivers no longer support this card."),
                _("NVIDIA's current drivers start at Turing (RTX 20xx / GTX 16xx); older cards only work with "
                  "legacy drivers, and even then the card would be too old for Kiro Atelier (see Card generation)."))
    return DRIVER_TITLE, FAIL, _("The NVIDIA driver is not working (not installed, or not loaded: restart). "
                                 "Kiro Atelier's Setup can install it; run this check again afterwards.")


# Compute capability → NVIDIA's name for that generation.
GENERATIONS = [(5.0, "Maxwell, GTX 900"), (6.0, "Pascal, GTX 10xx"), (7.0, "Volta"),
               (7.5, "Turing, RTX 20xx / GTX 16xx"), (8.0, "Ampere, RTX 30xx"), (8.9, "Ada, RTX 40xx"),
               (9.0, "Hopper"), (10.0, "Blackwell, RTX 50xx")]


# ComfyUI's own list of cards where fp16 is broken (comfy/model_management.py, should_use_fp16 → nvidia_16_series):
# it runs them in fp32. Same names, same case-sensitive match on the card name, so KA Check warns where ComfyUI slows.
SLOW_CARDS = ["1660", "1650", "1630", "T500", "T550", "T600", "MX550", "MX450", "CMP 30HX", "T2000", "T1000", "T1200"]


def _generation(cap):
    return next((name for start, name in reversed(GENERATIONS) if cap >= start), "older than Maxwell")


def check_generation():
    cap = _smi("compute_cap")
    if cap is None:
        return GENERATION_TITLE, FAIL, _no_card_reason()
    if float(cap) < MIN_COMPUTE:
        return (GENERATION_TITLE, FAIL, _("Too old: {generation}. Kiro Atelier needs an RTX 20xx / GTX 16xx or newer.")
                .format(generation=_generation(float(cap))),
                _("This card's compute capability is {cap}. The PyTorch build Kiro Atelier installs (for CUDA 12.8) "
                  "only contains code for compute 7.5 (Turing) and newer, so it can't run anything on this card. "
                  "An older PyTorch build still supports it, but Kiro Atelier isn't built or tested for that.")
                .format(cap=cap))
    if any(chip in (_smi("name") or "") for chip in SLOW_CARDS):
        return (GENERATION_TITLE, WARN, _("Supported, but untested and likely slow: {generation}.")
                .format(generation=_generation(float(cap))),
                _("ComfyUI treats GTX 16xx and similar cards differently from RTX cards: by default it doesn't use "
                  "half precision (fp16) on them, the fast mode RTX cards paint in. Expect painting to be clearly "
                  "slower, and some settings may not finish. Kiro Atelier hasn't been tested on these cards."))
    return GENERATION_TITLE, OK, _("Supported: {generation} (compute {cap}).").format(
        generation=_generation(float(cap)), cap=cap)


def check_vram():
    total = _smi("memory.total")
    if total is None:
        return VRAM_TITLE, FAIL, _no_card_reason()
    gb = int(total) / 1024
    if gb < MIN_VRAM_GB - 0.5:
        return (VRAM_TITLE, FAIL, _("{gb} GB, too little; painting needs at least {minimum} GB.").format(
            gb=f"{gb:.0f}", minimum=MIN_VRAM_GB),
            _("Kiro Atelier is built and tested for at least {minimum} GB of video memory. ComfyUI has memory-saving "
              "modes that may run the painting model (SDXL) on less, but slowly, and Kiro Atelier isn't tested that "
              "way; it can also run out of memory.").format(minimum=MIN_VRAM_GB))
    return VRAM_TITLE, OK, _("{gb} GB.").format(gb=f"{gb:.0f}")


def check_ram():
    kb = next(int(line.split()[1]) for line in Path("/proc/meminfo").read_text().splitlines()
              if line.startswith("MemTotal:"))
    gb = kb / 1024 / 1024
    if gb < MIN_RAM_GB:
        return (RAM_TITLE, FAIL, _("{gb} GB; Kiro Atelier needs 16 GB.").format(gb=f"{gb:.0f}"),
                _("While painting, ComfyUI keeps the SDXL model, the upscaler and the naming model in normal memory "
                  "next to the graphics card: about 10 GB. With less, the PC swaps to disk or stops with an "
                  "out-of-memory error."))
    if gb < GOOD_RAM_GB:
        return RAM_TITLE, WARN, _("{gb} GB; it runs, but 16 GB is advised (expect swapping, close the browser "
                                  "while painting).").format(gb=f"{gb:.0f}")
    return RAM_TITLE, OK, _("{gb} GB.").format(gb=f"{gb:.0f}")


def check_disk():
    stat = os.statvfs(Path.home())
    gb = stat.f_bavail * stat.f_frsize / 1_000_000_000
    if gb < MIN_DISK_GB:
        return (DISK_TITLE, FAIL, _("{gb} GB free in your home folder; about {needed} GB is needed.").format(
            gb=f"{gb:.0f}", needed=MIN_DISK_GB),
            _("ComfyUI and PyTorch take about 6 GB, the painting models (SDXL, its VAE, the upscaler, the naming "
              "model) about 7.5 GB, and the paintings themselves need room too."))
    return DISK_TITLE, OK, _("{gb} GB free in your home folder.").format(gb=f"{gb:.0f}")


CHECKS = [check_system, check_card, check_driver, check_generation, check_vram, check_ram, check_disk]


def run_checks():
    """All checks, in order."""
    return [(*result, None) if len(result) == 3 else result for result in (check() for check in CHECKS)]


GPU_CHECKS = (CARD_TITLE, DRIVER_TITLE, GENERATION_TITLE, VRAM_TITLE)


def advice(results):
    """What the user can do about the failed checks: (title, paragraph, numbered steps) per tip."""
    failed = {result[0] for result in results if result[1] == FAIL}
    warned = {result[0] for result in results if result[1] == WARN}
    tips = []
    if SYSTEM_TITLE in failed:
        tips.append((_("Use an Arch-based Linux system"),
                     _("Kiro Atelier is a package for Arch-based Linux: Kiro, KiroTux or Arch itself."), []))
    if DRIVER_TITLE in failed and not failed & {CARD_TITLE, GENERATION_TITLE} and not _old_chip():
        tips.append((_("Install the NVIDIA driver"),
                     _("The card is fine, only its driver is missing or not loaded."),
                     [_("Install the driver (on Kiro: run kiro-hwd)."), _("Restart the PC."), _("Run KA Check again.")]))
    if failed & set(GPU_CHECKS):
        tips.append((_("Let another PC do the painting"),
                     _("Kiro Atelier on this PC can send the wallpapers to another PC in your home and get the "
                       "paintings back. That PC does the painting, so it needs the NVIDIA card. Only an Arch-based "
                       "Linux PC (Kiro, KiroTux, Arch) is supported for that; Windows and Mac aren't."),
                     [_('Run KA Check on the other PC: it must say "This PC can run Kiro Atelier."'),
                      _("Install Kiro Atelier on both PCs."),
                      _('On this PC, open Settings and choose "ComfyUI runs on: Another computer".')]))
    if GENERATION_TITLE in warned:
        tips.append((_("Expect slow paintings"),
                     _("This card meets the requirements, but Kiro Atelier hasn't been tested on it and painting is "
                       "likely to be much slower than on an RTX card. An RTX card with 6 GB of video memory or more is "
                       "the safe choice."), []))
    if RAM_TITLE in failed:
        tips.append((_("Add memory"), _("Painting on this PC needs 16 GB of memory."), []))
    if RAM_TITLE in warned:
        tips.append((_("Keep memory free"), _("Close the browser and other big programs while painting."), []))
    if DISK_TITLE in failed:
        tips.append((_("Free up disk space"),
                     _("Make room in your home folder until about {needed} GB is free.").format(needed=MIN_DISK_GB), []))
    return tips


def verdict(results):
    """(status, one line) for the whole PC."""
    if any(result[1] == FAIL for result in results):
        return FAIL, _("This PC can't run Kiro Atelier.")
    if any(result[1] == WARN for result in results):
        return WARN, _("This PC can run Kiro Atelier, with the warning below.")
    return OK, _("This PC can run Kiro Atelier.")


# ── Terminal ────────────────────────────────────────────────────────
def show_text(results):
    """Print the report; returns the exit code."""
    colour = sys.stdout.isatty()
    marks = {OK: ("32", "OK  "), WARN: ("33", "WARN"), FAIL: ("31", "NO  ")}

    def paint(status, text):
        code = marks[status][0]
        return f"\033[{code}m{text}\033[0m" if colour else text

    def cells(text):
        # Terminal columns: Chinese and Japanese characters take two.
        return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)

    # The title column fits the longest title in this language (German and Russian ones are longer).
    width = max(cells(_(title)) for title, *_rest in results)
    print(_("KA Check: can this PC run Kiro Atelier?\n"))
    for title, status, detail, more in results:
        name = _(title)
        print(f"  {paint(status, marks[status][1])}  {name}{' ' * (width - cells(name))}  {detail}")
        if more and "--more" in sys.argv:
            print(f"{'':24}{more}")
    status, line = verdict(results)
    print(f"\n{paint(status, line)}")
    tips = advice(results)
    if tips:
        print(f"\n{_('What you can do')}")
    for title, text, steps in tips:
        print(f"\n  {title}\n  {text}")
        for number, step in enumerate(steps, 1):
            print(f"  {number}. {step}")
    print(f"\n{_('Which graphics cards work?')} kiro-atelier-check --cards")
    print(f"{_('Get Kiro Atelier on Ko-fi')}: {KOFI_URL}")
    return {OK: 0, FAIL: 1, WARN: 2}[status]


def show_cards_text():
    """Print the card list for the terminal."""
    print(_("Which graphics cards work?"))
    for status, heading, groups in CARD_LIST:
        print(f"\n{_(heading)}")
        for title, kind, cards in groups:
            print(f"  {_(title)}{' · ' + _(kind) if kind else ''}: {_(cards)}")
    print(f"\n{_(CARD_NOTE)}")
    return 0


# ── Card list ───────────────────────────────────────────────────────
# What a buyer can check before buying. Rule behind it: NVIDIA, Turing (compute 7.5) or newer, at least 6 GB of video
# memory; SLOW_CARDS with 6 GB or more get "very slowly". Card names stay English (they are product names); rows
# with ordinary words in them ("all versions", "and older") are N_() so they get translated, the rest pass _() as is.
# Checked 2026-11-06 against NVIDIA's spec pages (a Claude agent) and TechPowerUp + ComfyUI source (Copilot review,
# report kept in CHANGELOG). Only the RTX 2060 6 GB is tested; the list says "meets the requirements", not "works".
CARD_LIST = [
